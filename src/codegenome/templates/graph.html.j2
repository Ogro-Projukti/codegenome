                <path fill="currentColor" d="M19.25 15.25c.26 0 .5.15.61.39l.55 1.12 1.23.18a.68.68 0 0 1 .38 1.15l-.89.87.21 1.23a.68.68 0 0 1-.99.72l-1.1-.58-1.1.58a.68.68 0 0 1-.99-.72l.21-1.23-.89-.87a.68.68 0 0 1 .38-1.15l1.23-.18.55-1.12c.11-.24.35-.39.61-.39Z"/>
