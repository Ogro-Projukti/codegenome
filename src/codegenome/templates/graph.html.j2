    <script type="text/javascript">
        // Parse raw payload exported directly from SQLite and CodeGenome engine
        const graphData = {{ graph_json | safe }};
        const config = {{ config_json | safe }};

        let network = null;
        let nodesDataset = new vis.DataSet();
        let edgesDataset = new vis.DataSet();

        let rawNodes = graphData.nodes || [];
        let rawEdges = graphData.edges || [];
        
        // Hierarchical State
        let expandedFiles = new Set(); // Set of file node IDs that have been double-clicked
        let childToParent = new Map(); // Keep track of parent
        let nodeMap = new Map();

        // Metrics State
        let currentFilter = 'none';
        let graphMetrics = new Map();
        let maxMetrics = { in: 0, out: 0, churn: 0, comp: 0 };
        let currentSelectedNodeId = null;
        const aiState = {
            initialized: false,
            settings: null,
            providersById: new Map(),
            messages: [],
            busy: false
        };
        const aiContextHelp = {
            minimal: 'Minimal sends up to 4 important nodes, 12 import edges, 8 representative edges, and 3 selected-node neighbors.',
            small: 'Small sends up to 8 important nodes, 32 import edges, 16 representative edges, and 6 selected-node neighbors.',
            medium: 'Medium sends up to 16 important nodes, 96 import edges, 32 representative edges, and 12 selected-node neighbors.',
            full: 'Full sends up to 40 important nodes, 256 import edges, 96 representative edges, and 24 selected-node neighbors.',
            max: 'MAX sends up to 120 important nodes, 1000 import edges, 240 representative edges, and 48 selected-node neighbors.'
        };

        function calculateMetrics() {
            graphMetrics.clear();
            maxMetrics = { in: 0, out: 0, churn: 0, comp: 0 };
            rawNodes.forEach(n => {
                graphMetrics.set(n.id, { in: 0, out: 0, churn: n.churn || 0, comp: n.complexity || 0, bridge: n.is_bridge });
            });
            rawEdges.forEach(e => {
                if (graphMetrics.has(e.target)) graphMetrics.get(e.target).in++;
                if (graphMetrics.has(e.source)) graphMetrics.get(e.source).out++;
            });
            graphMetrics.forEach(m => {
                if(m.in > maxMetrics.in) maxMetrics.in = m.in;
                if(m.out > maxMetrics.out) maxMetrics.out = m.out;
                if(m.churn > maxMetrics.churn) maxMetrics.churn = m.churn;
                if(m.comp > maxMetrics.comp) maxMetrics.comp = m.comp;
            });
        }

        function parseGraphData() {
            nodeMap.clear();
            childToParent.clear();
            rawNodes.forEach(n => nodeMap.set(n.id, n));
            rawEdges.forEach(e => {
                if (e.edge_type === 'contains') {
                    childToParent.set(e.target, e.source);
                }
            });
        }

        function resolveProxy(nodeId) {
            const parentId = childToParent.get(nodeId);
            if (parentId && !expandedFiles.has(parentId)) {
                return parentId;
            }
            return nodeId;
        }

        function formatVisNode(n, isMicro) {
            const label = n.name || n.id;
            const shortLabel = label.split('/').pop().split('\\').pop();
            
            // Developer Theme Node Styling
            let shape = isMicro ? 'dot' : 'hexagon'; 
            let size = isMicro ? 12 : 28;
            
            let bgColor = isMicro ? '#0ea5e9' : '#3b82f6';
            let borderColor = isMicro ? '#0284c7' : '#1d4ed8';
            let fontColor = '#f8fafc';
            let fontSize = isMicro ? 11 : 14;

            if (n.node_type === 'import') { bgColor = '#f59e0b'; borderColor = '#b45309'; size = 10; }
            if (n.node_type === 'external') { bgColor = '#ef4444'; borderColor = '#b91c1c'; shape = 'triangle'; size = 14;}

            // Apply Filters
            if (currentFilter !== 'none') {
                const m = graphMetrics.get(n.id);
                let highlight = false;
                if (m) {
                    if (currentFilter === 'god-classes') {
                        highlight = (m.in > 0 && m.in >= maxMetrics.in * 0.5) || m.in > 8; 
                    } else if (currentFilter === 'fragile') {
                        highlight = (m.out > 0 && m.out >= maxMetrics.out * 0.5) || m.out > 8;
                    } else if (currentFilter === 'tech-debt') {
                        highlight = (m.churn > 0 && m.churn >= maxMetrics.churn * 0.3 && m.comp >= maxMetrics.comp * 0.3);
                    } else if (currentFilter === 'bridge') {
                        highlight = m.bridge === true;
                    } else if (currentFilter === 'root-nodes') {
                        highlight = (m.in === 0);
                    }
                }

                if (highlight) {
                    bgColor = '#ef4444'; 
                    borderColor = '#b91c1c';
                    size = size * 1.5;
                    fontColor = '#ffffff';
                    fontSize = fontSize * 1.2;
                } else {
                    bgColor = 'rgba(15, 23, 42, 0.3)';
                    borderColor = 'rgba(59, 130, 246, 0.1)';
                    fontColor = 'rgba(255,255,255,0.15)';
                }
            }

            return {
                id: n.id,
                label: shortLabel,
                title: n.id,
                shape: shape,
                size: size,
                color: {
                    background: bgColor,
                    border: borderColor,
                    highlight: { background: '#8b5cf6', border: '#d8b4fe' },
                    hover: { background: '#60a5fa', border: '#ffffff' }
                },
                font: { color: fontColor, size: fontSize, face: 'Outfit' },
                borderWidth: 2,
                raw: n
            };
        }

        function refreshGraphState() {
            const activeNodes = new Map();
            const activeEdges = new Map();
            
            rawNodes.forEach(n => {
                if (n.node_type === 'file') {
                    if (!expandedFiles.has(n.id)) {
                        activeNodes.set(n.id, formatVisNode(n, false));
                    }
                } 
                else {
                    const parentId = childToParent.get(n.id);
                    if (!parentId || expandedFiles.has(parentId)) {
                        activeNodes.set(n.id, formatVisNode(n, true));
                    }
                }
            });

            rawEdges.forEach(e => {
                if (e.edge_type === 'contains') return; 
                const proxyFrom = resolveProxy(e.source);
                const proxyTo = resolveProxy(e.target);
                if (proxyFrom === proxyTo) return; 
                if (!activeNodes.has(proxyFrom) || !activeNodes.has(proxyTo)) return;

                const edgeKey = `${proxyFrom}->${proxyTo}`;
                if (!activeEdges.has(edgeKey)) {
                    activeEdges.set(edgeKey, {
                        id: edgeKey,
                        from: proxyFrom,
                        to: proxyTo,
                        arrows: 'to',
                        color: { color: 'rgba(59, 130, 246, 0.4)', highlight: '#60a5fa', hover: '#93c5fd' },
                        width: e.edge_type === 'calls' ? 2 : 1,
                        dashes: e.edge_type === 'imports',
                        smooth: { type: 'continuous' }
                    });
                } else {
                    activeEdges.get(edgeKey).width += 0.5;
                    if(activeEdges.get(edgeKey).width > 10) activeEdges.get(edgeKey).width = 10;
                }
            });

            syncVisDataSet(nodesDataset, Array.from(activeNodes.values()));
            syncVisDataSet(edgesDataset, Array.from(activeEdges.values()));
        }

        function syncVisDataSet(dataset, newData) {
            const newIds = new Set(newData.map(item => item.id));
            const staleIds = dataset.getIds().filter(id => !newIds.has(id));
            if (staleIds.length > 0) dataset.remove(staleIds);
            dataset.update(newData);
        }

        function showDeltaToast(delta) {
            const toast = document.getElementById('toast');
            if (!toast) return;
            
            const parts = [];
            if (delta.added_nodes && delta.added_nodes.length) parts.push(`+${delta.added_nodes.length} node(s)`);
            if (delta.removed_nodes && delta.removed_nodes.length) parts.push(`-${delta.removed_nodes.length} node(s)`);
            if (delta.modified_nodes && delta.modified_nodes.length) parts.push(`${delta.modified_nodes.length} changed`);
            if (delta.added_edges && delta.added_edges.length) parts.push(`+${delta.added_edges.length} edge(s)`);
            
            if (parts.length === 0) return;

            toast.innerText = `Graph Evolved: ${parts.join(', ')}`;
            toast.classList.remove('hidden');
            
            if (toast.timeoutId) clearTimeout(toast.timeoutId);
            toast.timeoutId = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function normalizeGraphNodes(nodes) {
            return (nodes || []).map(n => ({
                ...n,
                id: n.id || n.node_id,
            }));
        }

        async function fetchGraphData() {
            try {
                const jsonUrl = config.liveJsonUrl || '/graph.json';
                const response = await fetch(jsonUrl + '?t=' + Date.now());
                const newData = await response.json();
                rawNodes = normalizeGraphNodes(newData.nodes);
                rawEdges = newData.edges || [];
                
                if (newData.metadata && newData.metadata.statistics) {
                    const stats = newData.metadata.statistics;
                    const elNodes = document.getElementById('stat-nodes');
                    const elEdges = document.getElementById('stat-edges');
                    const elFiles = document.getElementById('stat-files');
                    const elSymbols = document.getElementById('stat-symbols');
                    const elUpdated = document.getElementById('stat-updated');
                    
                    if (elNodes) elNodes.innerText = stats.node_count || rawNodes.length;
                    if (elEdges) elEdges.innerText = stats.edge_count || rawEdges.length;
                    if (elFiles) elFiles.innerText = stats.file_count || 0;
                    if (elSymbols) elSymbols.innerText = stats.symbol_count || 0;
                    
                    if (elUpdated) {
                        const now = new Date();
                        elUpdated.innerText = now.getHours().toString().padStart(2, '0') + ':' + 
                                              now.getMinutes().toString().padStart(2, '0') + ':' + 
                                              now.getSeconds().toString().padStart(2, '0');
                    }
                }

                calculateMetrics();
                parseGraphData();
                refreshGraphState();
                if (network) {
                    network.stabilize();
                }
            } catch (err) {
                console.error("Failed to fetch live graph:", err);
            }
        }

        function initNetwork() {
            // Fix: Calculate metrics and parse data BEFORE initializing the network,
            // otherwise nodeMap is empty and click details won't show!
            calculateMetrics();
            parseGraphData();
            refreshGraphState();

            const params = new URLSearchParams(window.location.search);
            if (params.get('live') === '1') {
                const wsPort = params.get('ws') || '8765';
                const liveWs = new WebSocket('ws://' + window.location.hostname + ':' + wsPort);
                liveWs.onmessage = (event) => {
                    try {
                        const payload = JSON.parse(event.data);
                        if (payload.type === 'graph_delta') {
                            showDeltaToast(payload);
                            fetchGraphData();
                        }
                    } catch (e) {
                        console.error('WebSocket message parse error', e);
                    }
                };
            }

            const container = document.getElementById('network-view');
            const data = { nodes: nodesDataset, edges: edgesDataset };
            const options = {
                physics: {
                    enabled: true,
                    stabilization: { enabled: true, iterations: 120, updateInterval: 25 },
                    barnesHut: { gravitationalConstant: -2500, centralGravity: 0.2, springLength: 120, springConstant: 0.04 }
                },
                interaction: { hover: true, tooltipDelay: 200, zoomView: true }
            };

            network = new vis.Network(container, data, options);

            network.once('stabilizationIterationsDone', function() {
                document.getElementById('loader-overlay').style.display = 'none';
            });
            setTimeout(() => { document.getElementById('loader-overlay').style.display = 'none'; }, 4000);

            network.on("doubleClick", function (params) {
                if (params.nodes.length > 0) {
                    const clickedId = params.nodes[0];
                    const raw = nodeMap.get(clickedId);
                    if (raw && raw.node_type === 'file') {
                        if (!expandedFiles.has(clickedId)) {
                            expandedFiles.add(clickedId);
                            refreshGraphState();
                        }
                    } else if (raw) {
                        const parentId = childToParent.get(clickedId);
                        if (parentId && expandedFiles.has(parentId)) {
                            expandedFiles.delete(parentId);
                            refreshGraphState();
                        }
                    }
                }
            });

            network.on("click", function (params) {
                if (params.nodes.length > 0) {
                    const selectedId = params.nodes[0];
                    const raw = nodeMap.get(selectedId);
                    if (raw) showDetails(raw);
                } else {
                    hideDetails();
                }
            });
        }

        function applyFilter(filterType, btnElement) {
            currentFilter = filterType;
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            if (btnElement) btnElement.classList.add('active');

            const expCard = document.getElementById('filter-explanation');
            const expTitle = document.getElementById('filter-exp-title');
            const expText = document.getElementById('filter-exp-text');

            if (filterType === 'none') {
                expCard.style.display = 'none';
            } else {
                expCard.style.display = 'block';
                if (filterType === 'god-classes') {
                    expTitle.innerText = 'God Node (High Fan-in)';
                    expText.innerHTML = 'Highlighted in red are nodes with a massive amount of incoming dependencies (other modules rely on them). Changing these is highly risky as they are load-bearing pillars of your codebase.';
                } else if (filterType === 'fragile') {
                    expTitle.innerText = 'Fragile Nodes (High Fan-out)';
                    expText.innerHTML = 'Highlighted in red are nodes that depend on too many other files. This makes them brittle, hard to test, and prime candidates for refactoring.';
                } else if (filterType === 'tech-debt') {
                    expTitle.innerText = 'Tech Debt (Churn + Complexity)';
                    expText.innerHTML = 'Highlighted in red are files that have high cyclomatic complexity AND are constantly being changed by developers. These are high-risk breeding grounds for bugs.';
                } else if (filterType === 'bridge') {
                    expTitle.innerText = 'Bridge Nodes (Choke Points)';
                    expText.innerHTML = 'Highlighted in red are nodes that act as the sole bridge connecting otherwise separate architectural domains. They represent critical structural bottlenecks.';
                } else if (filterType === 'root-nodes') {
                    expTitle.innerText = 'Root Nodes (Zero Fan-in)';
                    expText.innerHTML = 'Highlighted in red are nodes that have no incoming dependencies (nothing depends on them). These often act as entry points or top-level orchestrators.';
                }
            }

            refreshGraphState();
        }

        function collapseAllCells() {
            expandedFiles.clear();
            refreshGraphState();
            resetView();
        }

        function showDetails(node) {
            currentSelectedNodeId = node.id;
            document.getElementById('no-selection').style.display = 'none';
            const panel = document.getElementById('details-panel');
            panel.style.display = 'block';
            document.getElementById('node-title').innerText = node.name || node.id;
            const rowsContainer = document.getElementById('details-rows');
            rowsContainer.innerHTML = '';

            let inDegree = 0, outDegree = 0;
            rawEdges.forEach(e => {
                if (e.target === node.id) inDegree++;
                if (e.source === node.id) outDegree++;
            });

            const parentId = childToParent.get(node.id);
            const parentNode = parentId ? nodeMap.get(parentId) : null;
            const parentLabel = parentNode ? (parentNode.name || parentNode.id).split('/').pop() : 'None (Root Level)';
            
            let nodeTypeFormatted = (node.node_type || 'Unknown').charAt(0).toUpperCase() + (node.node_type || 'unknown').slice(1);
            if (node.node_type === 'symbol' && node.kind) {
                const kind = node.kind.charAt(0).toUpperCase() + node.kind.slice(1);
                nodeTypeFormatted = `${kind} (Symbol)`;
            }

            const fields = [
                { label: 'Codebase Type', value: nodeTypeFormatted },
                { label: 'Belongs to File', value: parentLabel },
                { label: 'File Path', value: node.file_path },
                { label: 'Qualified Name', value: node.qualified_name },
                { label: 'Language', value: node.language },
                { label: 'Complexity', value: node.complexity },
                { label: 'Churn (Commits)', value: node.churn },
                { label: 'Is Bridge Node', value: node.is_bridge ? 'Yes' : 'No' },
                { label: 'Incoming Links', value: inDegree },
                { label: 'Outgoing Links', value: outDegree }
            ];

            fields.forEach(f => {
                if (f.value !== undefined && f.value !== null) {
                    const row = document.createElement('div');
                    row.className = 'detail-row';
                    row.innerHTML = `
                        <div class="detail-label">${f.label}</div>
                        <div class="detail-value">${f.value}</div>
                    `;
                    rowsContainer.appendChild(row);
                }
            });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebar-toggle');
            sidebar.classList.toggle('collapsed');
            if (sidebar.classList.contains('collapsed')) {
                toggle.innerHTML = '&#9654;';
            } else {
                toggle.innerHTML = '&#9664;';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            let wasMobile = window.innerWidth <= 900;
            const sidebar = document.getElementById('sidebar');
            const toggle = document.getElementById('sidebar-toggle');
            
            if (wasMobile) {
                sidebar.classList.add('collapsed');
                toggle.innerHTML = '&#9654;';
            }
            
            window.addEventListener('resize', () => {
                const isMobile = window.innerWidth <= 900;
                if (isMobile && !wasMobile) {
                    sidebar.classList.add('collapsed');
                    toggle.innerHTML = '&#9654;';
                } else if (!isMobile && wasMobile) {
                    sidebar.classList.remove('collapsed');
                    toggle.innerHTML = '&#9664;';
                }
                wasMobile = isMobile;
            });
        });

        function hideDetails() {
            currentSelectedNodeId = null;
            document.getElementById('no-selection').style.display = 'block';
            document.getElementById('details-panel').style.display = 'none';
        }

        function toggleLegend() {
            const panel = document.getElementById('legend-panel');
            const btn = document.getElementById('legend-toggle-btn');
            if (panel.style.display === 'none') {
                panel.style.display = 'block';
                btn.style.display = 'none';
            } else {
                panel.style.display = 'none';
                btn.style.display = 'flex';
            }
        }

        function toggleFilters() {
            const panel = document.getElementById('top-filters');
            const btn = document.getElementById('filters-toggle-btn');
            if (panel.style.display === 'none') {
                panel.style.display = 'flex';
                btn.style.display = 'none';
            } else {
                panel.style.display = 'none';
                btn.style.display = 'flex';
            }
        }

        function resetView() {
            if (network) {
                network.fit({ animation: { duration: 600, easingFunction: 'easeInOutQuad' } });
            }
        }

        async function initAiChat() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('live') !== '1') return;

            const launcher = document.getElementById('ai-chat-launcher');
            launcher.classList.remove('ai-hidden');

            const input = document.getElementById('ai-chat-input');
            input.addEventListener('keydown', (event) => {
                if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
                    event.preventDefault();
                    sendAiMessage();
                }
            });

            document.getElementById('ai-provider').addEventListener('change', () => {
                renderAiProviderFields();
                renderAiSavedHint();
                resetAiModels();
            });
            document.getElementById('ai-context-size').addEventListener('change', renderAiContextHelp);
            renderAiContextHelp();

            try {
                const response = await fetch('/ai/settings', { cache: 'no-store' });
                const settings = await response.json();
                aiState.settings = settings;
                populateAiProviders(settings);
                addAiMessage('system', 'Loaded live graph chat. Provider calls use the current .genome graph each time you send.');
                renderAiSavedHint();
                aiState.initialized = true;
            } catch (error) {
                setAiStatus('Could not initialize AI chat settings.');
            }
        }

        function populateAiProviders(settings) {
            const providerSelect = document.getElementById('ai-provider');
            providerSelect.innerHTML = '';
            aiState.providersById = new Map();
            (settings.providers || []).forEach(provider => {
                aiState.providersById.set(provider.id, provider);
                const option = document.createElement('option');
                option.value = provider.id;
                option.textContent = provider.label;
                providerSelect.appendChild(option);
            });
            const defaultProvider = settings.default_provider || 'openai';
            providerSelect.value = aiState.providersById.has(defaultProvider) ? defaultProvider : 'openai';
            renderAiProviderFields();
        }

        function renderAiProviderFields() {
            const providerId = document.getElementById('ai-provider').value;
            const provider = aiState.providersById.get(providerId) || {};
            const keyField = document.getElementById('ai-api-key-field');
            const keyInput = document.getElementById('ai-api-key');
            const saveRow = document.getElementById('ai-save-row');
            const saveKey = document.getElementById('ai-save-key');

            keyField.style.display = 'flex';
            if (provider.requires_api_key === false) {
                keyInput.disabled = true;
                keyInput.value = '';
                keyInput.placeholder = 'Not required for local Ollama';
                saveRow.querySelector('label').style.display = 'none';
                saveKey.checked = false;
            } else {
                keyInput.disabled = false;
                keyInput.placeholder = 'Use a saved key or paste one for this session';
                saveRow.querySelector('label').style.display = 'inline-flex';
            }
        }

        function renderAiSavedHint() {
            const provider = document.getElementById('ai-provider').value;
            const providerMeta = aiState.providersById.get(provider) || {};
            if (providerMeta.requires_api_key === false) {
                setAiStatus('Local provider ready. Load models from Ollama.');
                return;
            }
            const saved = aiState.settings?.saved?.[provider];
            setAiStatus(saved ? 'Saved key available for this provider.' : 'Enter an API key, then load models.');
        }

        function renderAiContextHelp() {
            const select = document.getElementById('ai-context-size');
            const helper = document.getElementById('ai-context-help');
            if (!select || !helper) return;
            const message = aiContextHelp[select.value] || aiContextHelp.small;
            helper.textContent = message;
            helper.title = `${message} Data comes from the current .genome graph export.`;
        }

        function resetAiModels() {
            const modelSelect = document.getElementById('ai-model');
            modelSelect.innerHTML = '<option value="">Load models first</option>';
        }

        function toggleAiChat() {
            const panel = document.getElementById('ai-chat-panel');
            panel.classList.toggle('ai-hidden');
            if (!panel.classList.contains('ai-hidden')) {
                document.getElementById('ai-chat-input').focus();
                const provider = document.getElementById('ai-provider').value;
                const providerMeta = aiState.providersById.get(provider) || {};
                const canLoadModels = providerMeta.requires_api_key === false || aiState.settings?.saved?.[provider];
                const modelSelect = document.getElementById('ai-model');
                if (canLoadModels && !modelSelect.value && modelSelect.options.length <= 1) {
                    loadAiModels();
                }
            }
        }

        function toggleAiChatExpanded() {
            const panel = document.getElementById('ai-chat-panel');
            const button = document.getElementById('ai-expand-chat');
            const expanded = panel.classList.toggle('ai-expanded');
            button.setAttribute('aria-pressed', String(expanded));
            button.title = expanded ? 'Shrink AI chat' : 'Expand AI chat';
            button.setAttribute('aria-label', expanded ? 'Shrink AI chat' : 'Expand AI chat');
        }

        function toggleAiConfig() {
            const config = document.getElementById('ai-chat-config');
            const toggle = document.getElementById('ai-config-toggle');
            const collapsed = config.classList.toggle('ai-config-collapsed');
            toggle.setAttribute('aria-expanded', String(!collapsed));
        }

        async function loadAiModels() {
            if (aiState.busy) return;
            aiState.busy = true;
            setAiStatus('Loading models...');
            const button = document.getElementById('ai-load-models');
            button.disabled = true;

            try {
                const payload = aiRequestPayload();
                const response = await fetch('/ai/models', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const body = await response.json();
                if (!response.ok) throw new Error(body.error || 'Could not load models.');
                const modelSelect = document.getElementById('ai-model');
                modelSelect.innerHTML = '';
                body.models.forEach(model => {
                    const option = document.createElement('option');
                    option.value = model.id;
                    option.textContent = model.label;
                    modelSelect.appendChild(option);
                });
                if (payload.save_api_key) {
                    aiState.settings.saved[payload.provider] = true;
                }
                setAiStatus(`Loaded ${body.models.length} models.`);
            } catch (error) {
                resetAiModels();
                setAiStatus(error.message || 'Could not load models.');
            } finally {
                aiState.busy = false;
                button.disabled = false;
            }
        }

        async function sendAiMessage() {
            if (aiState.busy) return;
            const input = document.getElementById('ai-chat-input');
            const message = input.value.trim();
            if (!message) return;

            const model = document.getElementById('ai-model').value;
            if (!model) {
                setAiStatus('Choose a model before sending.');
                return;
            }

            aiState.messages.push({ role: 'user', content: message });
            addAiMessage('user', message);
            input.value = '';
            aiState.busy = true;
            document.getElementById('ai-send').disabled = true;
            setAiStatus('Thinking over the graph...');

            try {
                const payload = {
                    ...aiRequestPayload(),
                    model,
                    selected_node_id: currentSelectedNodeId,
                    messages: aiState.messages
                };
                const response = await fetch('/ai/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const body = await response.json();
                if (!response.ok) throw new Error(body.error || 'AI chat failed.');
                aiState.messages.push({ role: 'assistant', content: body.message });
                aiState.messages = aiState.messages.slice(-12);
                addAiMessage('assistant', body.message);
                if (payload.save_api_key) {
                    aiState.settings.saved[payload.provider] = true;
                }
                setAiStatus(currentSelectedNodeId ? 'Answered with selected-node context.' : 'Answered with graph context.');
            } catch (error) {
                aiState.messages.pop();
                addAiMessage('system', error.message || 'AI chat failed.');
                setAiStatus('Chat request failed.');
            } finally {
                aiState.busy = false;
                document.getElementById('ai-send').disabled = false;
            }
        }

        function aiRequestPayload() {
            const apiKey = document.getElementById('ai-api-key').value.trim();
            return {
                provider: document.getElementById('ai-provider').value,
                api_key: apiKey || null,
                context_size: document.getElementById('ai-context-size').value,
                save_api_key: document.getElementById('ai-save-key').checked
            };
        }

        function addAiMessage(role, content) {
            const list = document.getElementById('ai-chat-messages');
            const item = document.createElement('div');
            item.className = `ai-message ${role}`;
            item.textContent = content;
            list.appendChild(item);
            list.scrollTop = list.scrollHeight;
        }

        function setAiStatus(message) {
            const status = document.getElementById('ai-chat-status');
            if (status) status.textContent = message;
        }

        function filterGraph() {
            const query = document.getElementById('node-search').value.toLowerCase();
            if (query.length < 2) return;
            
            const activeNodes = nodesDataset.get();
            const filteredNodes = activeNodes.filter(n => {
                return n.id.toLowerCase().includes(query) || (n.label && n.label.toLowerCase().includes(query));
            });

            if (network && filteredNodes.length > 0) {
                network.selectNodes([filteredNodes[0].id]);
                network.focus(filteredNodes[0].id, { scale: 1.2, animation: { duration: 400 } });
                const raw = nodeMap.get(filteredNodes[0].id);
                if (raw) showDetails(raw);
            }
        }

        // Initialize when window loads
        window.addEventListener('load', async () => {
            if ((!rawNodes || rawNodes.length === 0) && config.liveJsonUrl) {
                await fetchGraphData();
            }
            initNetwork();
            initAiChat();
            lucide.createIcons();
        });
    </script>
</body>
</html>
