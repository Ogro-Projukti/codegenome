<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CodeGenome Graph Explorer - {{ workspace_name }}</title>
    <link rel="icon" type="image/x-icon" href="data:image/x-icon;base64,">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <script type="text/javascript" src="{{ script_src }}"></script>
    <link rel="stylesheet" href="graph-viewer.css">
    <style>
        :root {
            /* Developer Blue Theme Variables */
            --bg-primary: #020617;
            --bg-secondary: #0f172a;
            --bg-glass: rgba(15, 23, 42, 0.85);
            --border-glass: rgba(59, 130, 246, 0.2);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.35);
            --accent-cyan: #0ea5e9;
            --accent-purple: #8b5cf6;
            --sidebar-width: 380px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            overflow: hidden;
            height: 100vh;
            display: flex;
        }

        /* Loading Overlay */
        .loader-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: var(--bg-primary);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }

        .bio-loader {
            position: relative;
            width: 100px; height: 100px;
            animation: spin 8s linear infinite;
        }

        .cell {
            position: absolute;
            border-radius: 50%;
            background: var(--accent);
            box-shadow: 0 0 20px var(--accent-glow);
        }

        .core {
            width: 40px; height: 40px;
            top: 30px; left: 30px;
            animation: pulse 2s ease-in-out infinite;
        }

        .orbit1 { width: 16px; height: 16px; top: 0; left: 42px; background: var(--accent-cyan); }
        .orbit2 { width: 12px; height: 12px; bottom: 15px; right: 10px; background: var(--accent-purple); }
        .orbit3 { width: 20px; height: 20px; bottom: 20px; left: 10px; background: #f59e0b; }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes pulse { 
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.2); opacity: 1; }
        }

        .loader-text {
            margin-top: 30px;
            font-family: 'Outfit', sans-serif;
            font-size: 18px;
            font-weight: 600;
            color: var(--accent);
            letter-spacing: 3px;
            text-transform: uppercase;
            animation: pulse 2s ease-in-out infinite;
        }

        /* Glassmorphism sidebar */
        .sidebar {
            width: var(--sidebar-width);
            max-width: 100vw;
            flex-shrink: 0;
            height: 100vh;
            background: var(--bg-glass);
            backdrop-filter: blur(20px);
            border-right: 1px solid var(--border-glass);
            z-index: 100;
            display: flex;
            flex-direction: column;
            box-shadow: 10px 0 40px rgba(0, 0, 0, 0.6);
            transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .sidebar.collapsed {
            margin-left: calc(-1 * var(--sidebar-width));
        }

        .sidebar-toggle {
            position: absolute;
            top: 24px;
            right: -40px;
            width: 40px;
            height: 40px;
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-left: none;
            border-radius: 0 12px 12px 0;
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 14px;
            backdrop-filter: blur(20px);
            transition: all 0.3s;
            box-shadow: 5px 0 15px rgba(0,0,0,0.3);
            z-index: 101;
        }

        .sidebar-toggle:hover {
            background: rgba(16, 185, 129, 0.15);
            color: #fff;
        }

        .sidebar-header {
            padding: 24px;
            border-bottom: 1px solid var(--border-glass);
            background: radial-gradient(circle at top left, rgba(16,185,129,0.1), transparent 70%);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .logo-icon {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, var(--accent), var(--accent-cyan));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
            color: #fff;
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .logo-text {
            font-family: 'Outfit', sans-serif;
            font-size: 20px;
            font-weight: 700;
            background: linear-gradient(135deg, #ecfdf5, #6ee7b7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .workspace-tag {
            font-size: 12px;
            color: var(--text-secondary);
            background: rgba(16, 185, 129, 0.1);
            padding: 4px 10px;
            border-radius: 99px;
            border: 1px solid var(--border-glass);
            display: inline-block;
            margin-top: 4px;
        }

        .sidebar-content {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }
        
        .sidebar-content::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar-content::-webkit-scrollbar-thumb {
            background: var(--border-glass);
            border-radius: 4px;
        }

        .section-title {
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--accent);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        /* Stats grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: rgba(16, 185, 129, 0.03);
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            padding: 14px;
            text-align: left;
            transition: all 0.3s;
        }

        .stat-card:hover {
            background: rgba(59, 130, 246, 0.08);
            border-color: rgba(59, 130, 246, 0.4);
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.1);
        }

        .stat-val {
            font-family: 'Outfit', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: #ffffff;
        }

        .stat-lbl {
            font-size: 11px;
            color: var(--text-secondary);
            margin-top: 2px;
        }

        /* Search input */
        .search-box {
            position: relative;
            margin-bottom: 24px;
        }

        .search-input {
            width: 100%;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border-glass);
            border-radius: 10px;
            padding: 12px 16px;
            color: #ffffff;
            font-family: inherit;
            font-size: 14px;
            transition: all 0.2s;
        }

        .search-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 15px var(--accent-glow);
            background: rgba(16, 185, 129, 0.05);
        }

        /* Details Card */
        .details-panel {
            background: rgba(16, 185, 129, 0.05);
            border: 1px solid rgba(16, 185, 129, 0.2);
            border-radius: 12px;
            padding: 18px;
            margin-top: 20px;
            display: none;
        }

        .details-title {
            font-family: 'Outfit', sans-serif;
            font-size: 16px;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 12px;
            word-break: break-all;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .detail-row:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .detail-label {
            color: var(--text-secondary);
        }

        .detail-value {
            font-weight: 500;
            max-width: 60%;
            text-align: right;
            word-break: break-all;
            color: #ecfdf5;
        }

        /* Interactive Graph container */
        .graph-container {
            flex: 1;
            height: 100vh;
            position: relative;
            background: radial-gradient(circle at center, #051411 0%, #010605 100%);
        }
        
        /* Subtle modern grid background */
        .graph-container::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                linear-gradient(rgba(59, 130, 246, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(59, 130, 246, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
        }

        #network-view {
            width: 100%;
            height: 100%;
        }

        /* Floating controls */
        .floating-controls {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 12px;
            z-index: 10;
            width: max-content;
            max-width: calc(100% - 48px);
        }

        /* Legend Panel */
        .legend-panel {
            position: absolute;
            top: 24px;
            right: 24px;
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            padding: 16px;
            z-index: 10;
            backdrop-filter: blur(12px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.5);
            color: var(--text-primary);
            font-size: 13px;
        }

        .legend-title {
            font-family: 'Outfit', sans-serif;
            color: var(--accent);
            font-weight: 600;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 12px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }
        
        .legend-item:last-child {
            margin-bottom: 0;
        }

        .legend-shape {
            display: inline-block;
            box-shadow: 0 0 8px rgba(0,0,0,0.5);
        }

        /* Shapes CSS */
        .shape-hex { width: 14px; height: 16px; background: #3b82f6; clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%); border: 1px solid #1d4ed8; }
        .shape-dot-cyan { width: 12px; height: 12px; background: #0ea5e9; border-radius: 50%; border: 1px solid #0284c7; }
        .shape-dot-orange { width: 10px; height: 10px; background: #f59e0b; border-radius: 50%; border: 1px solid #b45309; }
        .shape-tri { width: 0; height: 0; border-left: 7px solid transparent; border-right: 7px solid transparent; border-bottom: 14px solid #ef4444; background: none; box-shadow: none; filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.4));}
        .line-solid { width: 20px; height: 2px; background: #3b82f6; box-shadow: 0 0 5px #3b82f6; }
        .line-dashed { width: 20px; height: 2px; background: transparent; border-bottom: 2px dashed #3b82f6; box-shadow: none; }

        .control-btn {
            background: var(--bg-glass);
            border: 1px solid var(--border-glass);
            color: var(--text-primary);
            padding: 5px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-family: 'Outfit', sans-serif;
            font-size: 11px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .control-btn .lucide {
            width: 12px;
            height: 12px;
        }
        
        .control-btn:hover {
            background: rgba(59, 130, 246, 0.15);
            border-color: #3b82f6;
        }

        .top-filters {
            position: absolute;
            top: 24px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            width: max-content;
            max-width: calc(100% - 48px);
            gap: 12px;
            z-index: 10;
            background: var(--bg-glass);
            padding: 8px;
            border-radius: 12px;
            border: 1px solid var(--border-glass);
            backdrop-filter: blur(12px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.5);
        }
        
        .top-filters .filter-btn {
            margin: 0;
            width: auto;
            text-align: center;
        }

        .filter-btn.active {
            background: rgba(59, 130, 246, 0.2);
            border-color: #3b82f6;
            color: #fff;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.2);
        }

        .instructions-card {
            background: rgba(16, 185, 129, 0.05);
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            padding: 16px;
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        .instructions-card ul {
            margin-left: 16px;
            margin-top: 8px;
        }
        
        .instructions-card li {
            margin-bottom: 4px;
        }
        
        .instructions-card strong {
            color: #ecfdf5;
        }

        .ai-chat-launcher {
            position: absolute;
            right: 24px;
            bottom: 24px;
            z-index: 30;
            width: 48px;
            height: 48px;
            min-width: 48px;
            padding: 0;
            border-radius: 999px;
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.95), rgba(59, 130, 246, 0.95));
            border: 1px solid rgba(186, 230, 253, 0.35);
            color: #fff;
            box-shadow: 0 10px 30px rgba(2, 6, 23, 0.45), 0 0 20px rgba(14, 165, 233, 0.32);
        }

        .ai-chat-launcher svg {
            width: 24px;
            height: 24px;
            display: block;
        }

        .ai-chat-panel {
            position: absolute;
            right: 24px;
            bottom: 78px;
            z-index: 31;
            width: min(440px, calc(100vw - 48px));
            height: min(640px, calc(100vh - 120px));
            display: flex;
            flex-direction: column;
            background: rgba(15, 23, 42, 0.96);
            border: 1px solid rgba(59, 130, 246, 0.34);
            border-radius: 12px;
            box-shadow: 0 22px 60px rgba(0, 0, 0, 0.56);
            backdrop-filter: blur(18px);
            overflow: hidden;
        }

        .ai-chat-panel.ai-expanded {
            width: min(900px, calc(100vw - 48px));
            height: min(820px, calc(100vh - 96px));
        }

        .ai-hidden {
            display: none !important;
        }

        .ai-chat-header,
        .ai-chat-compose {
            padding: 12px;
            border-bottom: 1px solid var(--border-glass);
        }

        .ai-chat-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .ai-chat-title {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .ai-chat-title strong {
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
        }

        .ai-chat-title span,
        .ai-chat-status,
        .ai-save-row {
            color: var(--text-secondary);
            font-size: 11px;
        }

        .ai-chat-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .ai-icon-btn {
            width: 32px;
            height: 32px;
            padding: 0;
            border-radius: 8px;
        }

        .ai-icon-btn svg {
            width: 15px;
            height: 15px;
        }

        .ai-collapse-icon,
        .ai-chat-panel.ai-expanded .ai-expand-icon {
            display: none;
        }

        .ai-chat-panel.ai-expanded .ai-collapse-icon {
            display: block;
        }

        .ai-chat-config {
            border-bottom: 1px solid var(--border-glass);
            background: rgba(2, 6, 23, 0.34);
        }

        .ai-config-toggle {
            width: 100%;
            min-height: 40px;
            border: 0;
            border-radius: 0;
            justify-content: space-between;
            padding: 0 12px;
            background: transparent;
        }

        .ai-config-toggle span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

        .ai-config-toggle > .lucide {
            transition: transform 0.2s;
        }

        .ai-chat-config.ai-config-collapsed .ai-config-toggle > .lucide {
            transform: rotate(-90deg);
        }

        .ai-config-body {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding: 12px;
        }

        .ai-chat-config.ai-config-collapsed .ai-config-body {
            display: none;
        }

        .ai-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
            min-width: 0;
        }

        .ai-field.ai-wide {
            grid-column: 1 / -1;
        }

        .ai-field label {
            color: var(--text-secondary);
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .ai-helper-text {
            color: var(--text-secondary);
            font-size: 11px;
            line-height: 1.4;
        }

        .ai-field select,
        .ai-field input,
        .ai-chat-compose textarea {
            width: 100%;
            border: 1px solid var(--border-glass);
            border-radius: 8px;
            background: rgba(2, 6, 23, 0.72);
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 12px;
            outline: none;
        }

        .ai-field select,
        .ai-field input {
            height: 34px;
            padding: 0 10px;
        }

        .ai-field select:focus,
        .ai-field input:focus,
        .ai-chat-compose textarea:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.2);
        }

        .ai-save-row {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .ai-save-row label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            cursor: pointer;
        }

        .ai-save-row input {
            width: 14px;
            height: 14px;
            accent-color: var(--accent);
        }

        .ai-chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-height: 0;
        }

        .ai-message {
            max-width: 92%;
            padding: 10px 12px;
            border-radius: 12px;
            border: 1px solid var(--border-glass);
            font-size: 12px;
            line-height: 1.55;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .ai-message.user {
            align-self: flex-end;
            background: rgba(59, 130, 246, 0.18);
            border-color: rgba(59, 130, 246, 0.35);
        }

        .ai-message.assistant,
        .ai-message.system {
            align-self: flex-start;
            background: rgba(2, 6, 23, 0.55);
        }

        .ai-message.system {
            color: var(--text-secondary);
        }

        .ai-chat-compose {
            border-top: 1px solid var(--border-glass);
            border-bottom: 0;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 8px;
        }

        .ai-chat-compose textarea {
            min-height: 54px;
            max-height: 130px;
            resize: vertical;
            padding: 9px 10px;
        }

        .ai-chat-compose button {
            align-self: end;
            height: 38px;
            min-width: 80px;
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid var(--accent);
            padding: 12px 24px;
            border-radius: 12px;
            color: #fff;
            font-family: 'Outfit', sans-serif;
            font-size: 14px;
            z-index: 1000;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 15px var(--accent-glow);
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
        }

        .toast.hidden {
            opacity: 0;
            transform: translate(-50%, 20px);
        }

        @media (max-width: 900px) {
            .sidebar {
                position: absolute;
            }
            .top-filters {
                top: 80px;
                max-width: calc(100% - 24px);
            }
            .legend-panel {
                top: 80px;
            }
            .floating-controls {
                bottom: 12px;
                max-width: calc(100% - 24px);
            }
            .ai-chat-panel {
                right: 12px;
                bottom: 68px;
                width: calc(100vw - 24px);
                height: min(620px, calc(100vh - 96px));
            }
            .ai-chat-panel.ai-expanded {
                width: calc(100vw - 24px);
                height: calc(100vh - 92px);
            }
            .ai-chat-launcher {
                right: 12px;
                bottom: 12px;
            }
        }
    </style>
</head>
<body>
    <div id="toast" class="toast hidden"></div>
    <div id="loader-overlay" class="loader-overlay">
        <div class="bio-loader">
            <div class="cell core"></div>
            <div class="cell orbit1"></div>
            <div class="cell orbit2"></div>
            <div class="cell orbit3"></div>
        </div>
        <div class="loader-text">Mapping Codebase...</div>
    </div>

    <div class="sidebar" id="sidebar">
        <div class="sidebar-toggle" id="sidebar-toggle" onclick="toggleSidebar()" title="Toggle Sidebar">
            &#9664;
        </div>
        <div class="sidebar-header">
            <a href="https://codegenome.pages.dev/" target="_blank" style="text-decoration: none;">
            <div class="logo-container">
                <img src="data:image/png;base64," alt="CodeGenome Logo" style="width: 32px; height: 32px; border-radius: 8px; filter: drop-shadow(0 0 10px var(--accent-glow)); object-fit: contain;">
                <div class="logo-text">CODEGENOME</div>
            </div>
            </a>
            <div class="workspace-tag">Workspace: {{ workspace_name }}</div>
        </div>

        <div class="sidebar-content">
            <div class="section-title">Codebase Metrics</div>
